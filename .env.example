# ── agent_factory（LLM + OCR 共用）────────────────────────────────
# 變數集合由 agent_factory 定義，本專案照用，不自行新增 endpoint／model 類變數。
# endpoint 與模型名寫在 agents.yaml 的 client.base_url / model，不放這裡。
#
# 本專案走本地 Ollama：OPENAI_API_KEY 不會被驗證，但 AsyncOpenAI 要求非空字串。
OPENAI_API_KEY=ollama
YAML_SETTINGS_FILE=agents.yaml
GLOBAL_CONCURRENCY=6
RPM=200
TPM=30000

# ── 輸入模式 ─────────────────────────────────────────────────────
# two_stage（預設）：影像先經 GLM-OCR 轉文字，再由抽取模型處理
# vision_direct：影像直接送抽取模型讀取並抽取，跳過 OCR 階段
# 僅影響影像與 PDF 輸入；純文字一律直接進階段 ②。
INGEST_MODE=two_stage

# PDF 逐頁渲染的解析度（1-600）。
# 過低傷辨識率；過高則 base64 過大，且逼近 OCR 模型的像素上限
# （A4 @ 200 DPI 約 1654x2339 = 3.9M px，GLM-OCR 上限 9.63M px）。
INGEST_PDF_DPI=200

# 抽取階段每次呼叫最多送幾個非空行。本地模型面對太多條目不會報錯，而是退化
# （吐壞 JSON、或只回一張卡）；失敗時階段會自動對半再切，此值只是起點。
INGEST_EXTRACT_CHUNK_LINES=20

# ── 階段間的 VRAM 讓渡 ───────────────────────────────────────────
# two_stage 下 GLM-OCR 2.2 GB 與抽取模型 20.3 GB 相加為 22.5 GB / 24 GB。
# 開啟後，ocr 階段結束會請 Ollama 立刻卸載 OCR 模型（keep_alive=0）。
# 僅對 Ollama 有效；endpoint 與模型名一律由 agents.yaml 推得，不在此宣告。
# 階段**開始前**卸載其他常駐模型。預設開啟——抽取 20.3 GB 與 OCR 2.2 GB
# 在 24 GB 卡上無法共存（桌面另佔數 GB），前一階段的模型不讓位，
# 這一階段的請求就會卡在 Ollama 排隊直到逾時。
MODEL_UNLOAD_BEFORE_STAGE=true

# 階段**結束後**卸載自己用的模型。預設關閉——只有要把 VRAM 讓給非 Ollama 的
# 消費者（Phase 3 的 ComfyUI）時才需要；開啟會讓下一階段付出冷載入代價。
MODEL_UNLOAD_ENABLED=false

MODEL_UNLOAD_TIMEOUT=30

# ── 工作目錄 ─────────────────────────────────────────────────────
WORK_DIR=./work
OUTPUT_DIR=./output

# ── ComfyUI 連線與共用參數（Phase 3）──────────────────────────────
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_POLL_INTERVAL=2.0
COMFYUI_TIMEOUT=300
COMFYUI_BATCH_SIZE=4
# 前段畫質／解剖負向詞（含動漫 SDXL 慣用的 worst detail、sketch），後段防文字。
# 不要加 close-up portrait／headshot——實測會讓模型把主體整個推出畫面。
#
# ⚠ 這串只對下面的 SDXL 那組有效。kyoani workflow 的 cfg 是 1、負向接
#   ConditioningZeroOut，負向條件根本不參與取樣——在那組**調負向詞是白調**，
#   防文字完全靠 prompts/ 的 prompt 端治本（2026-08-27）
COMFYUI_NEGATIVE_PROMPT=bad quality, worst quality, worst detail, low quality, lowres, jpeg artifacts, blurry, sketch, bad anatomy, bad hands, extra fingers, fused fingers, missing fingers, deformed, disfigured, mutated, bad proportions, extra limbs, missing limbs, long neck, cropped, error, text, letters, words, caption, subtitle, signature, watermark, username, artist name

# ── ComfyUI workflow 與節點注入點（Phase 3；Phase 7 起預設 kyoani）─
# workflow 由使用者自帶，節點 ID 因人而異。
# 取得方式：ComfyUI 中以 Save (API Format) 匯出，JSON 頂層 key 即節點 ID。
# positive / negative / output 為必填；seed 與寬高選填，未指定則不注入。
#
# 下面兩組是「整組換」的關係：workflow 路徑、觸發詞前綴、尺寸、VRAM 讓渡與
# 節點 ID 綁在一起。只改 COMFYUI_WORKFLOW_PATH 一行必定對不上節點 ID。

# ══ 生效中：FLUX.2-klein-9B + KyoAni Style LoRA ══
# 2026-08-27～28 四輪 A/B 對 SDXL 6 勝 2 和，見
# logs/2026-08-27_eval_flux2-klein-9b-ab.md
COMFYUI_WORKFLOW_PATH=workflows/card_image_kyoani.json
# 語法層用哪個 agent —— **這一行就是 profile 的開關**。
# 模型專屬的三件事（目標語法、LoRA 觸發詞、風格後綴）全部寫在該 agent 的
# prompt 檔裡，不散在這裡。換模型＝改這一行加下面那組節點 ID，然後
# anki-builder prompt --force；語義層（image_scene）完全不動。
#
# ImagePromptFluxAgent → prompts/image_prompt_flux.md
#   自然語言敘述式 ＋ 觸發詞 `Anime. `（KyoAni LoRA 少了它等於沒掛）
IMAGE_PROMPT_AGENT=ImagePromptFluxAgent
# ⚠ 不要往上加。第四輪實測 1440×900 與 1600×896 都更暗更糊，加步數也修不掉；
#   1600×896 還會糊出假日文。這個模型對尺寸極度敏感
COMFYUI_IMAGE_WIDTH=1344
COMFYUI_IMAGE_HEIGHT=768
# extract 與 audio 開始前請 ComfyUI 釋放 VRAM（變數名的「LLM」是歷史包袱，
# 語意以 release_comfyui() 的 docstring 為準）。這份 workflow 常駐 17.4 GB，
# 加上 VOXCPM2 峰值 7.5 GB 會超出 24 GB 卡——**這組設定下必須開**。
# 代價是 ComfyUI 下次生成要重載模型（冷啟首張約 100 秒）
COMFYUI_FREE_BEFORE_LLM=true
COMFYUI_POSITIVE_NODE_ID=96
COMFYUI_POSITIVE_FIELD=text
# 999 是**刻意的孤兒節點**，不是打錯：它不被輸出節點依賴，ComfyUI 根本不執行
# 它，存在的唯一理由是讓 workflow.validate() 的必填檢查過關。見上面的 ⚠
COMFYUI_NEGATIVE_NODE_ID=999
COMFYUI_NEGATIVE_FIELD=text
COMFYUI_SEED_NODE_ID=90
COMFYUI_SEED_FIELD=noise_seed
# 寬高在 88／89 兩個獨立的 PrimitiveInt（同一組值還餵給 Flux2Scheduler），
# 不是單一 latent 節點的兩個欄位，所以 LATENT_NODE_ID 留空
COMFYUI_LATENT_NODE_ID=
COMFYUI_WIDTH_NODE_ID=88
COMFYUI_WIDTH_FIELD=value
COMFYUI_HEIGHT_NODE_ID=89
COMFYUI_HEIGHT_FIELD=value
COMFYUI_OUTPUT_NODE_ID=109

# ══ 回頭路：fabricatedXL／SDXL + FaceDetailer（Phase 3～6 用的那組）══
# 正負向注入 ImpactWildcardProcessor 的 wildcard_text，保留其後的
# concat → 正則去逗號 那條鏈；輸出節點 100 是本專案專用的 PreviewImage。
# 寬高走單一 latent 節點 37 的 width／height，所以不設 WIDTH/HEIGHT_NODE_ID。
# 換回來要把上面整組註解掉、下面整組解開，再 anki-builder image --force 重生
# （兩種畫風混在同一副牌組會很明顯）。
#COMFYUI_WORKFLOW_PATH=workflows/card_image_xl.json
## ImagePromptSDXLAgent → prompts/image_prompt_sdxl.md
## 逗號 tag 式：場景原樣照抄 ＋ 統一風格後綴
#IMAGE_PROMPT_AGENT=ImagePromptSDXLAgent
## SDXL 的 16:9 官方建議尺寸。改用 SD 1.5 系列的 workflow 時要改回 768×432
#COMFYUI_IMAGE_WIDTH=1344
#COMFYUI_IMAGE_HEIGHT=768
## SDXL 常駐 7.2 GB，加 VOXCPM2 只到 14.7 GB，24 GB 卡放得下，可以關
#COMFYUI_FREE_BEFORE_LLM=false
#COMFYUI_POSITIVE_NODE_ID=3
#COMFYUI_POSITIVE_FIELD=wildcard_text
#COMFYUI_NEGATIVE_NODE_ID=4
#COMFYUI_NEGATIVE_FIELD=wildcard_text
#COMFYUI_SEED_NODE_ID=32
#COMFYUI_SEED_FIELD=seed
#COMFYUI_LATENT_NODE_ID=37
#COMFYUI_WIDTH_NODE_ID=
#COMFYUI_WIDTH_FIELD=width
#COMFYUI_HEIGHT_NODE_ID=
#COMFYUI_HEIGHT_FIELD=height
#COMFYUI_OUTPUT_NODE_ID=100

# ── 牌組媒體格式 ─────────────────────────────────────────────────
# 記憶引擎（engines/anki_engine.html）以 JSZip 把 ZIP 內每個檔案解成 Blob 常駐
# 記憶體，體積直接決定它在手機上會不會被系統殺掉。實測 308 張卡：
#   PNG + WAV 約 443 MB → WebP + MP3 約 35 MB
# 轉檔由既有相依完成（Pillow、soundfile），不需要 ffmpeg。
# 設成 png／wav 即原樣輸出，不轉檔。
MEDIA_IMAGE_FORMAT=webp
MEDIA_IMAGE_QUALITY=92
MEDIA_AUDIO_FORMAT=mp3
# 0 最好、1 最小。0.4 對單聲道語音已聽不出差別
MEDIA_AUDIO_COMPRESSION=0.4

# ── VOXCPM2（Phase 4）────────────────────────────────────────────
# voxcpm 是本機 Python 套件，推論跑在本行程內的 GPU 上，不是 HTTP 服務——
# 因此沒有 endpoint、沒有連線逾時，也沒有 language／speed／speaker_id。
VOXCPM2_MODEL_PATH=/home/jason/disk2/voxcpm2
# 留空為自動選擇（優先 CUDA）
VOXCPM2_DEVICE=

# ── 音色：三種來源，彼此不互斥，換路線只要改設定 ──
# 1) Voice Design：文字描述指定音色，不需要任何音檔。留空則不啟用。
#    描述用括號包住，會接在每段要唸的文字前面。
VOXCPM2_VOICE_DESCRIPTION=(A young woman, clear and steady voice, neutral American accent, calm pace)
# 2) voice cloning：參考音檔。與上面併用時，描述退為風格控制
VOXCPM2_REFERENCE_WAV=
# 3) continuation：兩者必須同時給或同時留空。與 REFERENCE_WAV 指向同一個檔
#    即模型 README 的 Ultimate Cloning（最高保真），逐字稿須與音檔完全一致
VOXCPM2_PROMPT_WAV=
VOXCPM2_PROMPT_TEXT=

# 生成參數
VOXCPM2_CFG_VALUE=2.0
VOXCPM2_INFERENCE_TIMESTEPS=10
VOXCPM2_NORMALIZE=false
# 對參考音檔降噪需 ModelScope 的 zipenhancer 模型，會觸發下載，預設關閉
VOXCPM2_ENABLE_DENOISER=false
VOXCPM2_DENOISE=false
# torch.compile 最佳化；除錯時可關閉
VOXCPM2_OPTIMIZE=true
# 本行程內的 GPU 推論本就序列化，設 1 以外的值不會更快
VOXCPM2_CONCURRENCY=1

# ── 輸出響度 ──
# 統一每段語音的音量。模型逐段生成的音量本來就飄（616 段實測全距 83 dB），
# 播起來就是時大時小。與上面的 VOXCPM2_NORMALIZE 無關——那個是文字正規化
VOXCPM2_LOUDNESS_NORMALIZE=true
# 目標響度（閘門後 RMS，dBFS）。調高更大聲，但受峰值上限牽制
VOXCPM2_LOUDNESS_TARGET_DBFS=-20.0
# 峰值上限（dBFS）。放大到目標會削波時改以此為準，留 1 dB 餘裕
VOXCPM2_LOUDNESS_PEAK_DBFS=-1.0

# 背面語音要不要連譯文一起唸。關閉時唸 tts_back_text（只有原文），
# 開啟時改唸 example（原文＋譯文）
VOXCPM2_SPEAK_TRANSLATION=false
