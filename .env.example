# ── agent_factory（LLM + OCR 共用）────────────────────────────────
# 變數集合由 agent_factory 定義，本專案照用，不自行新增 endpoint／model 類變數。
# endpoint 與模型名寫在 agents.yaml 的 client.base_url / model，不放這裡。
#
# 本專案走本地 Ollama：OPENAI_API_KEY 不會被驗證，但 AsyncOpenAI 要求非空字串。
OPENAI_API_KEY=ollama
YAML_SETTINGS_FILE=agents.yaml
GLOBAL_CONCURRENCY=6
RPM=200
TPM=30000

# ── 輸入模式 ─────────────────────────────────────────────────────
# two_stage（預設）：影像先經 GLM-OCR 轉文字，再由抽取模型處理
# vision_direct：影像直接送抽取模型讀取並抽取，跳過 OCR 階段
# 僅影響影像與 PDF 輸入；純文字一律直接進階段 ②。
INGEST_MODE=two_stage

# PDF 逐頁渲染的解析度（1-600）。
# 過低傷辨識率；過高則 base64 過大，且逼近 OCR 模型的像素上限
# （A4 @ 200 DPI 約 1654x2339 = 3.9M px，GLM-OCR 上限 9.63M px）。
INGEST_PDF_DPI=200

# 抽取階段每次呼叫最多送幾個非空行。本地模型面對太多條目不會報錯，而是退化
# （吐壞 JSON、或只回一張卡）；失敗時階段會自動對半再切，此值只是起點。
INGEST_EXTRACT_CHUNK_LINES=20

# ── 階段間的 VRAM 讓渡 ───────────────────────────────────────────
# two_stage 下 GLM-OCR 2.2 GB 與抽取模型 20.3 GB 相加為 22.5 GB / 24 GB。
# 開啟後，ocr 階段結束會請 Ollama 立刻卸載 OCR 模型（keep_alive=0）。
# 僅對 Ollama 有效；endpoint 與模型名一律由 agents.yaml 推得，不在此宣告。
# 階段**開始前**卸載其他常駐模型。預設開啟——抽取 20.3 GB 與 OCR 2.2 GB
# 在 24 GB 卡上無法共存（桌面另佔數 GB），前一階段的模型不讓位，
# 這一階段的請求就會卡在 Ollama 排隊直到逾時。
MODEL_UNLOAD_BEFORE_STAGE=true

# 階段**結束後**卸載自己用的模型。預設關閉——只有要把 VRAM 讓給非 Ollama 的
# 消費者（Phase 3 的 ComfyUI）時才需要；開啟會讓下一階段付出冷載入代價。
MODEL_UNLOAD_ENABLED=false

MODEL_UNLOAD_TIMEOUT=30

# ── 工作目錄 ─────────────────────────────────────────────────────
WORK_DIR=./work
OUTPUT_DIR=./output

# ── ComfyUI 連線與生成參數（Phase 3）──────────────────────────────
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_WORKFLOW_PATH=workflows/card_image.json
COMFYUI_POLL_INTERVAL=2.0
COMFYUI_TIMEOUT=300
COMFYUI_BATCH_SIZE=4
COMFYUI_IMAGE_WIDTH=1024
COMFYUI_IMAGE_HEIGHT=576
# 記憶錨點圖不得含任何文字，負向 prompt 刻意涵蓋各種文字相關詞彙
COMFYUI_NEGATIVE_PROMPT=text, watermark, signature, letters, words, caption, subtitle

# ── ComfyUI 節點注入點（Phase 3）──────────────────────────────────
# workflow 由使用者自帶，節點 ID 因人而異。
# 取得方式：ComfyUI 中以 Save (API Format) 匯出，JSON 頂層 key 即節點 ID。
# positive / negative / output 為必填；seed 與 latent 尺寸選填，未指定則不注入。
COMFYUI_POSITIVE_NODE_ID=6
COMFYUI_POSITIVE_FIELD=text
COMFYUI_NEGATIVE_NODE_ID=7
COMFYUI_NEGATIVE_FIELD=text
COMFYUI_SEED_NODE_ID=3
COMFYUI_SEED_FIELD=seed
COMFYUI_LATENT_NODE_ID=5
COMFYUI_WIDTH_FIELD=width
COMFYUI_HEIGHT_FIELD=height
COMFYUI_OUTPUT_NODE_ID=9

# ── VOXCPM2（Phase 4）────────────────────────────────────────────
# voxcpm 是本機 Python 套件，推論跑在本行程內的 GPU 上，不是 HTTP 服務——
# 因此沒有 endpoint、沒有連線逾時，也沒有 language／speed／speaker_id。
VOXCPM2_MODEL_PATH=/home/jason/disk2/voxcpm2
# 留空為自動選擇（優先 CUDA）
VOXCPM2_DEVICE=

# 音色：參考音檔（voice cloning）。留空則每次生成都是隨機音色，
# 整套牌組的聲音不會一致。不需要逐字稿。
VOXCPM2_REFERENCE_WAV=
# 進階：continuation 模式，兩者必須同時給或同時留空
VOXCPM2_PROMPT_WAV=
VOXCPM2_PROMPT_TEXT=

# 生成參數
VOXCPM2_CFG_VALUE=2.0
VOXCPM2_INFERENCE_TIMESTEPS=10
VOXCPM2_NORMALIZE=false
# 對參考音檔降噪需 ModelScope 的 zipenhancer 模型，會觸發下載，預設關閉
VOXCPM2_ENABLE_DENOISER=false
VOXCPM2_DENOISE=false
# torch.compile 最佳化；除錯時可關閉
VOXCPM2_OPTIMIZE=true
# 本行程內的 GPU 推論本就序列化，設 1 以外的值不會更快
VOXCPM2_CONCURRENCY=1
